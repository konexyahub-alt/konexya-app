# Copie para .env.local no desenvolvimento. NUNCA versione valores reais.
# Em teste e produção, os valores ficam nas variáveis de ambiente da Vercel
# (Preview = teste, Production = produção), cada um apontando para o seu projeto Supabase.

# local | teste | producao
NEXT_PUBLIC_APP_ENV=local

# --- Etapa 0: Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Etapa 2: somente servidor ---
# Chave secreta do Supabase (Project Settings > API Keys > Secret keys). Ignora o RLS: o código só a usa
# para gravar o que a IA e o sistema escrevem (assistente, resumo, sugestões, registro da IA).
SUPABASE_SECRET_KEY=
# IA (console da Anthropic). Sem ela, a conversa segue só com as respostas rápidas.
ANTHROPIC_API_KEY=
# Opcional: modelo da IA (padrão claude-opus-5-5)
# ANTHROPIC_MODEL=

# --- Outras etapas ---
# Etapa 1: e-mail de convites da equipe (o código de login é enviado pelo Supabase, com a mesma chave
# cadastrada como segredo RESEND_API_KEY no GitHub). Remetente no domínio verificado no Resend.
# RESEND_API_KEY=
# RESEND_FROM=Konexya <nao-responda@mail.konexya.com.br>
# Etapa 1: Google Places (autocompletar endereço)
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Etapa 3: Google Routes (somente servidor)
# GOOGLE_ROUTES_API_KEY=
# Etapa 4: WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
